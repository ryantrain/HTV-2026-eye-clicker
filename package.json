{
  "name": "omniaccess",
  "productName": "OmniAccess",
  "version": "0.1.0",
  "private": true,
  "description": "Hands-free desktop accessibility overlay",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Ryan Tran",
    "email": "188256973+ryantrain@users.noreply.github.com."
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "dev": "electron-forge start",
    "test": "vitest run && npm run test:api",
    "web:dev": "vite --config vite.renderer.config.mts",
    "web:build": "vite build --config vite.renderer.config.mts",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "demo": "npm run web:build && npm run server",
    "test:api": "node --test server/*.test.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-squirrel-startup": "^1.0.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
